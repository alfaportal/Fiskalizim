  "rules_for_pos": {
    "product_must_have_vat": true,
    "owner_is_not_tax_expert": true,
    "on_install": "Seed template me produkte + vat_letter/vat_category të sakta",
    "on_new_product": "Smart mapping sipas fjalëve kyçe → propozo A/C/D/E automatikisht",
    "on_sale": "Llogarit TVSH automatikisht nga produkti — pa llogaritje manuale në faturë",
    "default_if_unknown": "E (18%) — me paralajmërim që të verifikohet"
  },
  "what_is_hs_cn": {
    "hs": "Harmonized System — kod ndërkombëtar i mallrave (dogana)",
    "cn": "Combined Nomenclature — varianti europian/doganor i HS",
    "why": "Ligji i TVSH klasifikon sipas llojit të mallit (shpesh i lidhur me kodin doganor), JO sipas emrit të markës.",
    "when_needed": "Market / import / saktësi e lartë. Për kafene/hotel shpesh mjafton kategoria + emri.",
    "examples": [
      { "code": "2203", "means": "Birra", "typical_vat": "E · 18%" },
      { "code": "0401", "means": "Qumësht", "typical_vat": "D · 8%" },
      { "code": "8471", "means": "Laptop / kompjuter", "typical_vat": "D · 8%" },
      { "code": "2202", "means": "Pije të ëmbla (Cola etj.)", "typical_vat": "E · 18%" }
    ]
  },
  "what_is_smart_mapping": {
    "definition": "Programi propozon vetë TVSH-në kur shkruhet emri ose skanohet barkodi.",
    "inputs": ["emri i produktit", "barkodi (nëse njihet)", "kategoria e zgjedhur"],
    "outputs": ["vat_letter A/C/D/E", "vat_percent 0/8/18"],
    "examples": [
      { "typed": "Birra Peja 0.5L", "result": "E · 18%", "why": "keyword birra" },
      { "typed": "Qumësht 1L", "result": "D · 8%", "why": "keyword qumësht" },
      { "typed": "Espresso", "result": "E · 18%", "why": "keyword espresso/kafe" },
      { "typed": "Sallam", "result": "KËRKO ZGJEDHJE", "why": "disputed — mos auto" }
    ]
  },
