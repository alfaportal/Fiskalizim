  "smart_mapping_algorithm": {
    "description": "Kur përdoruesi shkruan emrin e produktit të ri:",
    "steps": [
      "1) Normalizo tekstin (lowercase, hiq diacritics opsionale).",
      "2) Nëse emri përputhet me products[].keywords → përdor letter/rate e produktit.",
      "3) Përndryshe kërko categories[].keywords (përjashto disputed_verify).",
      "4) Nëse bie te disputed_verify → MOS auto-vendos; kërko zgjedhje / shfaq paralajmërim.",
      "5) Nëse asnjë match → default E · 18% + shënim 'verifiko'.",
      "6) Ruaj vat_letter + vat_category (0/8/18) në DB të produktit."
    ]
  }
}
